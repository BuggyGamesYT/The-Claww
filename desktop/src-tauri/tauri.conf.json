{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Claww",
  "version": "0.2.4",
  "identifier": "com.buggygamesyt.theclaww",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "The Claww", "width": 1120, "height": 800, "minWidth": 420, "minHeight": 560 }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/claw"],
    "category": "DeveloperTool",
    "shortDescription": "Local AI agent with Ollama",
    "linux": { "deb": { "depends": [] } }
  }
}
