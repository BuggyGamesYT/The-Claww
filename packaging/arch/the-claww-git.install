post_install() {
  echo ">> Open The Claww from your app menu (or run: the-claww). Terminal version: claw"
  echo ">> claw is set up for local Ollama (OLLAMA_HOST=http://127.0.0.1:11434, model qwen3-coder:30b)."
  echo ">> Make sure Ollama is running:  sudo systemctl enable --now ollama"
  echo ">> Change defaults in /etc/the-claww/env or ~/.config/the-claww/env."
}
post_upgrade() { post_install; }
