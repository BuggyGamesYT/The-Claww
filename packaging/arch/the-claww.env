# Defaults applied by /usr/bin/claw when not already set in your shell.
# Per-user overrides: ~/.config/the-claww/env (same format, wins over this file).

# Local Ollama endpoint. When set, claw routes every model to Ollama (no API key).
OLLAMA_HOST=http://127.0.0.1:11434

# Default Ollama tag used when you don't pass --model.
# Pull it first:  ollama pull qwen3-coder:30b
CLAW_MODEL=qwen3-coder:30b
